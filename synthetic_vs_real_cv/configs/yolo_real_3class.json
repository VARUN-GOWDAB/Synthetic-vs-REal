{
  "model": {
    "name": "yolov8n.pt",
    "architecture": "YOLOv8n",
    "image_size": 640,
    "epochs": 50,
    "batch_size": 16,
    "learning_rate": 0.01,
    "optimizer": "AdamW",
    "patience": 20,
    "seed": 42
  },
  "data": {
    "yaml": "data/real_safety_500/data.yaml",
    "classes": [
      "worker",
      "helmet",
      "vest"
    ],
    "class_ids": {
      "worker": 0,
      "helmet": 1,
      "vest": 2
    }
  },
  "training": {
    "device": "cpu",
    "project": "results/runs",
    "name": "real_worker_helmet_vest",
    "exist_ok": false
  },
  "evaluation": {
    "metrics": [
      "precision",
      "recall",
      "mAP50",
      "mAP50_95"
    ],
    "iou_threshold": 0.5
  },
  "annotation_status": "Supplied PPE labels remapped and quality selected; not exhaustive manual verification",
  "annotation_source": "data/real_safety_500",
  "selected_images": 500
}